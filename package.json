{
  "name": "library-book-management-prisma",
  "version": "2.0.0",
  "description": "Library Book Management REST API upgraded with Prisma ORM and PostgreSQL (Express 5 + TypeScript + Zod)",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "test": "tsx src/test-api.ts"
  },
  "keywords": [
    "express",
    "express5",
    "typescript",
    "prisma",
    "postgresql",
    "zod",
    "rest-api",
    "crud"
  ],
  "author": "Yusuf Madarati",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
