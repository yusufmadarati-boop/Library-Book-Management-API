// Prisma Schema for Library Book Management API (PostgreSQL)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Book {
  id        String   @id @default(uuid())
  title     String
  author    String
  genre     String
  available Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([genre])
  @@index([available])
}
